#!/usr/bin/env python3
"""Run dpf from a source checkout without installing it."""
import os
import sys

if os.geteuid() == 0:  # e.g. `sudo dpf smart`: leave no root-owned __pycache__ in the checkout
    sys.dont_write_bytecode = True

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from dpf.cli import main  # noqa: E402

sys.exit(main())
