# exiftool config for `dpf exif` (passed with -config, so no user config is loaded).
# Composite tags whose values `-n` or duplicate tag names would otherwise hide:
#   DpfLens        LensID as text (with -n, LensID is the maker's numeric lens code)
#   DpfXMPRating   XMP Rating (Lightroom, Bridge)
#   DpfEXIFRating  EXIF/IFD0 Rating (Windows, some cameras)
# Plain `Rating` is exiftool's own pick, which differs by format (JPEG: XMP, TIFF: EXIF).
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::Composite' => {
        DpfLens => { Require => 'LensID', ValueConv => '$prt[0]' },
        DpfXMPRating => { Require => 'XMP:Rating', ValueConv => '$val[0]' },
        DpfEXIFRating => { Require => 'EXIF:Rating', ValueConv => '$val[0]' },
    },
);
1;
